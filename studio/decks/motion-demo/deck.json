{
  "$schema": "../../src/schema/deck.schema.json",
  "version": 1,
  "title": "Motion-Demo",
  "description": "Phase 8a–8c: Bewegung, Kurven, Pfade, Szenen, kinetische Typo, Formwandel, Daten, Partikel, Generativ, Shader-Looks, Physik.",
