        "type": "meshGradient",
        "colors": [
          "brand.background",
          "brand.accent2",
          "brand.surface"
        ],
        "animate": true
      },
      "elements": [
        {
          "id": "kicker",
          "frame": {
            "x": 160,
            "y": 160,
            "w": 1000,
            "h": 40
          },
          "build": {
            "in": {
              "preset": "fade"
            },
            "trigger": "afterPrevious"
          },
          "type": "text",
          "content": "Phase 8a · Pfad & Feder",
          "style": "label"
        },
        {
          "id": "titel",
          "frame": {
            "x": 160,
            "y": 230,
            "w": 1200,
            "h": 340
          },
          "motion": [
            {
              "step": 0,
              "duration": 1400,
              "ease": "spring(0.35)",
              "from": {
                "y": 120,
                "scale": 0.92,
                "opacity": 0,
                "blur": 30
