{
  "$schema": "../../src/schema/deck.schema.json",
  "version": 1,
  "title": "Motion-Demo",
  "description": "Phase 8a: freie Bewegungen, Timing-Kurven, Pfade, Schleifen und Szenen.",
  "format": {
    "preset": "16:9",
    "width": 1920,
    "height": 1080
  },
  "theme": "silber",
  "intensity": 0.3,
  "slides": [
    {
      "id": "pfad",
      "background": {
        "type": "meshGradient",
        "colors": [
          "brand.background",
          "brand.accent2",
          "brand.surface"
        ],
        "animate": true
      },
      "elements": [
        {
          "id": "kicker",
          "frame": {
            "x": 160,
            "y": 160,
            "w": 1000,
            "h": 40
          },
          "build": {
            "in": {
              "preset": "fade"
            },
            "trigger": "afterPrevious"
          },
          "type": "text",
          "content": "Phase 8a · Pfad & Feder",
          "style": "label"
        },
        {
          "id": "titel",
          "frame": {
            "x": 160,
            "y": 230,
            "w": 1200,
            "h": 340
          },
          "motion": [
            {
              "step": 0,
              "duration": 1400,
              "ease": "spring(0.35)",
              "from": {
                "y": 120,
                "scale": 0.92,
                "opacity": 0,
                "blur": 30
              }
            }
          ],
          "type": "text",
          "content": "Alles kann\n*sich bewegen.*",
          "style": "display"
        },
        {
          "id": "flieger",
          "frame": {
            "x": 1500,
            "y": 640,
            "w": 120,
            "h": 120
          },
          "motion": [
            {
              "step": 1,
              "duration": 2200,
              "ease": "inOut",
              "from": {
                "scale": 0.4,
                "opacity": 0
              },
              "to": {
                "scale": 1,
                "opacity": 1
              },
              "path": "M 120 980 C 520 380, 1000 1060, 1560 700",
              "orient": true
            },
            {
              "step": 1,
              "at": 2300,
              "duration": 2600,
              "ease": "inOut",
              "to": {
                "y": -26,
                "rotate": 6
              },
              "repeat": -1,
              "yoyo": true
            }
          ],
          "type": "icon",
          "icon": "send",
          "color": "brand.accent",
          "strokeWidth": 1.5
        },
        {
          "id": "hinweis",
          "frame": {
            "x": 160,
            "y": 900,
            "w": 1200,
            "h": 40
          },
          "build": {
            "in": {
              "preset": "fade"
            },
            "trigger": "afterPrevious"
          },
          "type": "text",
          "content": "Klick: das Icon fliegt auf einem Pfad herein und schwebt danach endlos.",
          "style": "caption"
        }
      ]
    },
    {
      "id": "schluessel",
      "background": {
        "type": "color",
        "color": "brand.background"
      },
      "transition": {
        "type": "blurDissolve"
      },
      "elements": [
        {
          "id": "titel",
          "frame": {
            "x": 160,
            "y": 140,
            "w": 1600,
            "h": 130
          },
          "build": {
            "in": {
              "preset": "blurRise"
            },
            "trigger": "afterPrevious"
          },
          "type": "text",
          "content": "Schlüssel, Kurven, Farbe.",
          "style": "title"
        },
        {
          "id": "kreis",
          "frame": {
            "x": 260,
            "y": 500,
            "w": 200,
            "h": 200
          },
          "motion": [
            {
              "step": 1,
              "duration": 2400,
              "ease": "inOut",
              "keys": [
                {
                  "x": 0,
                  "y": 0,
                  "scale": 1
                },
                {
                  "x": 600,
                  "y": -180,
                  "scale": 0.6,
                  "t": 0.35,
                  "ease": "out"
                },
                {
                  "x": 1100,
                  "y": 60,
                  "scale": 1.3,
                  "fill": "brand.textMuted",
                  "t": 0.7
                },
                {
                  "x": 1200,
                  "y": 0,
                  "scale": 1
                }
              ]
            }
          ],
          "type": "shape",
          "shape": "ellipse",
          "fill": "brand.accent"
        },
        {
          "id": "glocke",
          "frame": {
            "x": 1600,
            "y": 820,
            "w": 100,
            "h": 100
          },
          "motion": [
            {
              "step": 2,
              "duration": 900,
              "ease": "wiggle(7)",
              "to": {
                "rotate": 16
              }
            }
          ],
          "type": "icon",
          "icon": "bell",
          "color": "brand.text",
          "strokeWidth": 1.5
        },
        {
          "id": "wuerfel",
          "frame": {
            "x": 160,
            "y": 800,
            "w": 320,
            "h": 160
          },
          "motion": [
            {
              "step": 2,
              "duration": 1600,
              "ease": "spring(0.5)",
              "from": {
                "z": -400,
                "rotateY": -80,
                "opacity": 0
              }
            }
          ],
          "type": "shape",
          "shape": "rect",
          "fill": "brand.surface",
          "radius": 24
        },
        {
          "id": "wuerfel-text",
          "frame": {
            "x": 160,
            "y": 800,
            "w": 320,
            "h": 160
          },
          "motion": [
            {
              "step": 2,
              "duration": 1600,
              "ease": "spring(0.5)",
              "from": {
                "z": -400,
                "rotateY": -80,
                "opacity": 0
              }
            }
          ],
          "type": "text",
          "content": "3D-Drehung mit Feder",
          "style": "body",
          "align": "center",
          "verticalAlign": "middle"
        }
      ]
    },
    {
      "id": "szene",
      "background": {
        "type": "color",
        "color": "brand.background"
      },
      "transition": {
        "type": "dissolve"
      },
      "scene": {
        "duration": 6000,
        "loop": true
      },
      "elements": [
        {
          "id": "zeile",
          "frame": {
            "x": 160,
            "y": 200,
            "w": 1600,
            "h": 90
          },
          "build": {
            "in": {
              "preset": "wordByWord"
            }
          },
          "type": "text",
          "content": "Eine Szene läuft wie ein Film.",
          "style": "heading",
          "align": "center"
        },
        {
          "id": "punkt-1",
          "frame": {
            "x": 600,
            "y": 560,
            "w": 80,
            "h": 80
          },
          "motion": [
            {
              "at": 600,
              "duration": 1800,
              "ease": "bounce",
              "from": {
                "y": -400,
                "opacity": 0
              }
            }
          ],
          "type": "shape",
          "shape": "ellipse",
          "fill": "brand.accent"
        },
        {
          "id": "punkt-2",
          "frame": {
            "x": 920,
            "y": 560,
            "w": 80,
            "h": 80
          },
          "motion": [
            {
              "at": 900,
              "duration": 1800,
              "ease": "bounce",
              "from": {
                "y": -400,
                "opacity": 0
              }
            }
          ],
          "type": "shape",
          "shape": "ellipse",
          "fill": "brand.textMuted"
        },
        {
          "id": "punkt-3",
          "frame": {
            "x": 1240,
            "y": 560,
            "w": 80,
            "h": 80
          },
          "motion": [
            {
              "at": 1200,
              "duration": 1800,
              "ease": "bounce",
              "from": {
                "y": -400,
                "opacity": 0
              }
            },
            {
              "at": 3600,
              "duration": 1200,
              "ease": "elastic",
              "to": {
                "scale": 1.6
              }
            },
            {
              "at": 4900,
              "duration": 800,
              "ease": "inOut",
              "to": {
                "scale": 1,
                "opacity": 0
              }
            }
          ],
          "type": "shape",
          "shape": "ellipse",
          "fill": "brand.text"
        },
        {
          "id": "hinweis",
          "frame": {
            "x": 160,
            "y": 900,
            "w": 1600,
            "h": 40
          },
          "type": "text",
          "content": "Läuft in Schleife – ein Klick geht weiter.",
          "style": "caption",
          "align": "center"
        }
      ]
    }
  ]
}
