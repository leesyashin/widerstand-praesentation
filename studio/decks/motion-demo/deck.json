              "step": 1,
              "duration": 2200,
              "ease": "inOut",
              "from": {
                "scale": 0.4,
                "opacity": 0
              },
              "to": {
                "scale": 1,
                "opacity": 1
              },
              "path": "M 120 980 C 520 380, 1000 1060, 1560 700",
