{
  "$schema": "../../src/schema/theme.schema.json",
  "name": "silber",
  "label": "Silber",
  "description": "Silbergelatine: dunkel, ruhig, Licht-Verlauf auf Titel- und Kapitelfolien.",
  "textStyles": {
    "display": { "font": "display", "size": 156, "weight": 700, "lineHeight": 0.98, "letterSpacing": -0.04, "color": "brand.text" },
    "title": { "font": "display", "size": 100, "weight": 650, "lineHeight": 1.03, "letterSpacing": -0.03, "color": "brand.text" },
    "heading": { "font": "display", "size": 60, "weight": 600, "lineHeight": 1.08, "letterSpacing": -0.02, "color": "brand.text" },
    "subtitle": { "font": "text", "size": 42, "weight": 400, "lineHeight": 1.3, "letterSpacing": -0.01, "color": "brand.textMuted" },
    "body": { "font": "text", "size": 32, "weight": 400, "lineHeight": 1.45, "letterSpacing": 0, "color": "brand.text" },
    "caption": { "font": "text", "size": 24, "weight": 400, "lineHeight": 1.4, "letterSpacing": 0.005, "color": "brand.textMuted" },
    "label": { "font": "text", "size": 22, "weight": 600, "lineHeight": 1.2, "letterSpacing": 0.14, "color": "brand.accent", "uppercase": true }
  },
  "backgrounds": {
    "title": { "type": "meshGradient", "colors": ["brand.background", "brand.accent2", "brand.accent", "brand.surface"], "animate": true },
    "content": { "type": "color", "color": "brand.background" },
    "light": { "type": "color", "color": "brand.light" }
  },
  "effects": {
    "title": [{ "type": "grain", "amount": 0.1 }, { "type": "vignette", "amount": 0.3 }]
  }
}
