{
  "$schema": "../../src/schema/layout.schema.json",
  "name": "kontakt",
  "label": "Kontakt",
  "description": "Abschluss mit Einladung und Kontaktdaten.",
  "surface": "title",
  "width": 1920,
  "height": 1080,
  "elements": [
    {
      "id": "kicker",
      "type": "text",
      "style": "label",
      "content": "Kontakt",
      "frame": {
        "x": 160,
        "y": 320,
        "w": 1600,
        "h": 40
      },
      "build": {
        "in": {
          "preset": "fade"
        },
        "trigger": "afterPrevious"
      }
    },
    {
      "id": "headline",
      "type": "text",
      "style": "title",
      "content": "Lass uns sprechen.",
      "frame": {
        "x": 160,
        "y": 380,
        "w": 1600,
        "h": 130
      },
      "match": "headline",
      "build": {
        "in": {
          "preset": "blurRise"
        },
        "trigger": "withPrevious"
      }
    },
    {
      "id": "email",
      "type": "text",
      "style": "subtitle",
      "content": "name@beispiel.de",
      "frame": {
        "x": 160,
        "y": 580,
        "w": 1000,
        "h": 60
      },
      "build": {
        "in": {
          "preset": "rise"
        },
        "trigger": "afterPrevious"
      }
    },
    {
      "id": "telefon",
      "type": "text",
      "style": "subtitle",
      "content": "+49 000 000 000",
      "frame": {
        "x": 160,
        "y": 650,
        "w": 1000,
        "h": 60
      },
      "build": {
        "in": {
          "preset": "rise",
          "delay": 80
        },
        "trigger": "withPrevious"
      }
    },
    {
      "id": "web",
      "type": "text",
      "style": "subtitle",
      "content": "beispiel.de",
      "frame": {
        "x": 160,
        "y": 720,
        "w": 1000,
        "h": 60
      },
      "build": {
        "in": {
          "preset": "rise",
          "delay": 160
        },
        "trigger": "withPrevious"
      }
    },
    {
      "id": "logo",
      "name": "Logo",
      "type": "icon",
      "icon": "brand/logo-mono.svg",
      "color": "brand.text",
      "frame": {
        "x": 160,
        "y": 930,
        "w": 234,
        "h": 60
      }
    }
  ]
}
