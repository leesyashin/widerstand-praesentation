      "frame": {
        "x": 160,
        "y": 456,
        "w": 1600,
        "h": 8
      },
      "build": {
        "in": {
          "preset": "drawLine",
          "duration": 1200
        },
        "trigger": "afterPrevious"
      }
    },
    {
      "id": "punkt-1",
