{
  "$schema": "../../src/schema/layout.schema.json",
  "name": "ablauf",
  "label": "Ablauf",
  "description": "Vier Schritte auf einer Zeitachse.",
  "surface": "content",
  "width": 1920,
  "height": 1080,
  "elements": [
    {
      "id": "headline",
      "type": "text",
      "style": "title",
      "content": "So gehen wir vor.",
      "frame": {
        "x": 160,
        "y": 120,
        "w": 1600,
        "h": 120
